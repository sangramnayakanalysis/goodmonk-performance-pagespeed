# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
# In GitHub Actions, these same names are set as repository Secrets instead
# (see .github/workflows/monitor.yml) — .env is only used for local runs.

# --- Google PageSpeed Insights -----------------------------------------
GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_api_key_here
PAGESPEED_STRATEGY=mobile

# --- Networking / retries --------------------------------------------------
REQUEST_TIMEOUT_SECONDS=30
API_MAX_RETRIES=3
API_RETRY_BASE_DELAY_SECONDS=3
RATE_LIMIT_WAIT_SECONDS=30
MAX_WORKERS=4

# --- Google Sheets -----------------------------------------------------------
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Local development: path to a downloaded service-account key file.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# CI (GitHub Actions): paste the whole JSON key content into a repo secret
# named GOOGLE_SERVICE_ACCOUNT_JSON instead — leave this blank locally.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Email (optional — leave blank to disable email reports) ---------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Traffic-light thresholds (3-tier: green / amber / red) ----------------
# Our target score is 60, not Google's "good" bar of 90 — see the July 2026
# manager review. All optional; defaults shown below.
SCORE_GREEN_MIN=60
SCORE_AMBER_MIN=40
LCP_GREEN_MAX=2.5
LCP_AMBER_MAX=4.0
CLS_GREEN_MAX=0.1
CLS_AMBER_MAX=0.25
TTFB_GREEN_MAX=0.8
TTFB_AMBER_MAX=1.8
TBT_GREEN_MAX_MS=200
TBT_AMBER_MAX_MS=600
